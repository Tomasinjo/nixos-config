{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 8pm on Friday"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)service\\.nix$/",
        "/(^|/)oci-framework\\.nix$/"
      ],
      "matchStrings": [
        "image\\s*=\\s*\"(?<depName>[^\"]+):(?<currentValue>[^\"]+)\";"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "platformAutomerge": false,
  "automergeType": "pr",
  
  "packageRules": [
    {
      "addLabels": ["update"],
      "description": "Parses linuxserver unusual image names. Rules above apply normally.",
      "versioning": "regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)((\\.|-r)(?<build>\\d+))?-ls(?<revision>\\d+)$",
      "matchPackageNames": [
        "/^(gh|ls)cr\\.io\\/linuxserver\\//"
      ]
    },
    {
      "description": "Weekly automerge of container images - patches (grouped)",
      "matchManagers": ["custom.regex"],
      "matchUpdateTypes": ["patch", "digest"],
      "groupName": "container images - minor",
      "schedule": ["before 8pm on Friday"],
      "automerge": true,
      "addLabels": ["update"]
    },
    {
      "description": "Weekly PRs for container images - minor/major",
      "matchManagers": ["custom.regex"],
      "matchUpdateTypes": ["minor", "major"],
      "schedule": ["before 8pm on Friday"],
      "automerge": false,
      "addLabels": ["update"]
    },
    {
      "description": "Weekly automerge of trusted container images - minor/patch (grouped)",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["postgres", "mongo", "redis", "wollomatic/socket-proxy", "eclipse-mosquitto"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "stable container images",
      "automerge": true,
      "schedule": ["before 8pm on Friday"],
      "addLabels": ["update"]
    },
    {
      "description": "Ignore major updates for trusted container images",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["postgres", "mongo", "redis", "wollomatic/socket-proxy", "eclipse-mosquitto"],
      "matchUpdateTypes": ["major"],
      "enabled": false,
      "addLabels": ["update"]
    }
  ]
}
